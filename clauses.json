    {
      "role": "supervision.server",
      "id": "supervision.ss.metadata-issuer",
      "source": "supervision",
      "section": "Supervisor Metadata, line 157: issuer (REQUIRED) is the SS's HTTPS server identifier",
      "anchor": "ss-metadata",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.metadata-endpoints",
      "source": "supervision",
      "section": "Supervisor Metadata, lines 159-162: connect, mission, decision and event endpoints (REQUIRED); line 165: endpoint URLs MUST be HTTPS on the issuer's origin",
      "anchor": "ss-metadata",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.core-verification",
      "source": "core",
      "section": "AAuth Protocol Verification (Server), line 2242: any signature failure MUST be a 401 with the appropriate Signature-Error; step 2 answers missing required coverage with invalid_input (the SS requires content-digest and content-type on a body, Supervision line 188)",
      "anchor": "verification",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.connected-only",
      "source": "supervision",
      "section": "PS Authentication, line 188: the SS MUST accept requests only from a PS it has connected for the sub the request names, answering others unsupported_iss (403) or unknown_sub (404)",
      "anchor": "common-request",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.connect-action",
      "source": "supervision",
      "section": "Connect, line 238: action (REQUIRED) is connect or disconnect; a missing or unrecognized action is invalid_request (Errors, line 631)",
      "anchor": "connect",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.envelope",
      "source": "supervision",
      "section": "Envelope, lines 196 and 198-200: sdi, iat, sub and agent (REQUIRED) on a supervision request; a missing member is invalid_request (Errors, line 631)",
      "anchor": "envelope",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.event-id",
      "source": "supervision",
      "section": "Envelope, line 197: id (REQUIRED) on an event and on a report; a missing member is invalid_request (Errors, line 631)",
      "anchor": "envelope",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.sdi-echo",
      "source": "supervision",
      "section": "Supervision Decisions, line 280: the response MUST echo the request's sdi",
      "anchor": "decisions",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.deferred-pending",
      "source": "supervision",
      "section": "Deferred Decisions, line 286: an SS that cannot answer returns 202 with Location and Retry-After (stated without a BCP 14 keyword; the same paragraph's MUSTs are supervision.ss.deferred-poller)",
      "anchor": "deferred-decisions",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.deferred-poller",
      "source": "supervision",
      "section": "Deferred Decisions, line 286: the SS MUST verify the poller is the identity that made the request and MUST answer unknown_pending to any other",
      "anchor": "deferred-decisions",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.idempotence",
      "source": "supervision",
      "section": "Idempotence, line 316: a repeated request under an answered sdi MUST get the same decision and, where the SS signs, the same signed response; one still deciding is answered 202 with the same Location",
      "anchor": "idempotence",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.signed-coverage",
      "source": "supervision",
      "section": "Signed Decisions, line 340: the response signature MUST cover @status, content-type and content-digest (signed under the issuer's jwks_uri key, line 320)",
      "anchor": "signed-decisions",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.mission-action",
      "source": "supervision",
      "section": "Mission Endpoint, line 360: action is REQUIRED on a request to a mission's URL and the SS MUST reject a missing or unrecognized action with invalid_request",
      "anchor": "mission-endpoint",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.act-members",
      "source": "supervision",
      "section": "Proposal line 394 (agent_token), Person Token lines 480-481 (resource, agent_token), Auth Token line 504 (resource_token, presented_token): REQUIRED members; a missing member is invalid_request (Errors, line 631)",
      "anchor": "decision-endpoint",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.decision-resolved-answer",
      "source": "supervision",
      "section": "Decision Resolved, line 572: answer (REQUIRED); a missing member is invalid_request (Errors, line 631)",
      "anchor": "event-decision-resolved",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.rate-limited",
      "source": "supervision",
      "section": "Errors, line 636: rate_limited is 429 and Retry-After is REQUIRED",
      "anchor": "errors",
      "scope": "protocol"
    },
    {
      "role": "supervision.server",
      "id": "supervision.ss.host-policy",
      "source": "supervision",
      "section": "Fixture host policy: the connect and decision policies the launcher configures, and that the policy's allow, deny or deferral reaches the wire",
      "anchor": "decisions",
      "scope": "adapter-contract"
    },
    {
      "role": "supervision.person-server",
      "id": "supervision.ps.core-keying",
      "source": "core",
      "section": "AAuth Protocol Keying Material, line 2187: a PS making a signed request in its own right MUST use the jwks_uri scheme with id its issuer and dwk aauth-person.json (Supervision PS Authentication, line 181)",
      "anchor": "keying-material",
      "scope": "protocol"
    },
    {
      "role": "supervision.person-server",
