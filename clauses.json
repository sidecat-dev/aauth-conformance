      "source": "supervision",
      "section": "PS Authentication, line 188: the signature MUST cover content-digest and content-type on a request with a body",
      "anchor": "common-request",
      "scope": "protocol"
    },
    {
      "role": "supervision.person-server",
      "id": "supervision.ps.envelope",
      "source": "supervision",
