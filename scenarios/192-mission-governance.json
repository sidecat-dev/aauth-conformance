{
  "version": 1,
  "id": "mission-governance",
  "title": "Missions: Permission and audit refuse a completed mission",
  "role_under_test": "mission.person-server",
  "given": "agent-identity",
  "input": {
    "flow": "governance"
  },
  "assertions": [
    {
      "id": "before-permission-status-class-0",
      "stage": "before-permission",
      "kind": "status-class",
      "equals": "2xx",
      "clause": "mission.host-policy"
    },
    {
      "id": "before-audit-status-class-1",
      "stage": "before-audit",
      "kind": "status-class",
      "equals": "2xx",
      "clause": "mission.host-policy"
    },
    {
      "id": "action-status-class-2",
      "stage": "action",
      "kind": "status-class",
      "equals": "2xx",
      "clause": "mission.host-policy"
    },
    {
      "id": "after-permission-status-3",
      "stage": "after-permission",
      "kind": "status",
      "equals": 403,
      "clause": "mission.status-error"
    },
    {
      "id": "after-permission-json-member-4",
      "stage": "after-permission",
      "kind": "json-member",
      "equals": "mission_terminated",
      "clause": "mission.terminated-rejected",
      "member": "error"
    },
    {
      "id": "after-permission-json-member-5",
      "stage": "after-permission",
      "kind": "json-member",
      "equals": "terminated",
      "clause": "mission.status-error",
      "member": "mission_status"
    },
    {
      "id": "after-audit-status-6",
      "stage": "after-audit",
      "kind": "status",
      "equals": 403,
      "clause": "mission.status-error"
    },
    {
      "id": "after-audit-json-member-7",
      "stage": "after-audit",
      "kind": "json-member",
      "equals": "mission_terminated",
      "clause": "mission.terminated-rejected",
      "member": "error"
    },
    {
      "id": "after-audit-json-member-8",
      "stage": "after-audit",
      "kind": "json-member",
      "equals": "terminated",
      "clause": "mission.status-error",
      "member": "mission_status"
    }
  ]
}
