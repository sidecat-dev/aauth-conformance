{
  "version": 1,
  "id": "events-ap-uncovered-content-digest",
  "title": "A body whose signature omits content-digest",
  "role_under_test": "events.agent-provider",
  "given": "agent-identity",
  "input": {
    "max_uses": 0,
    "deliveries": [
      {
        "mutation": "uncovered-content-digest",
        "body": true
      }
    ]
  },
  "assertions": [
    {
      "stage": "delivery-1",
      "id": "status",
      "clause": "events.ap.coverage",
      "kind": "status",
      "equals": 401
    },
    {
      "stage": "delivery-1",
      "id": "error",
      "clause": "events.ap.input-code",
      "kind": "sfv-token",
      "header": "Signature-Error",
      "member": "error",
      "equals": "invalid_input"
    },
    {
      "stage": "delivery-1",
      "id": "problem-type",
      "clause": "events.ap.problem-type",
      "kind": "problem-if-present",
      "equals": "invalid_input"
    }
  ]
}
