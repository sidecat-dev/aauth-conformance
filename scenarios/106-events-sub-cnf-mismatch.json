{
  "version": 1,
  "id": "events-sub-cnf-mismatch",
  "title": "Registration signed by a key other than cnf.jwk",
  "role_under_test": "events.subscription",
  "given": "agent-identity",
  "input": {
    "mutation": "cnf-mismatch"
  },
  "assertions": [
    {
      "stage": "registration",
      "id": "status",
      "clause": "events.sub.cnf",
      "kind": "status",
      "equals": 401
    },
    {
      "stage": "registration",
      "id": "error",
      "clause": "events.sub.signature-code",
      "kind": "sfv-token",
      "header": "Signature-Error",
      "member": "error",
      "equals": "invalid_signature"
    },
    {
      "stage": "registration",
      "id": "problem-type",
      "clause": "events.sub.problem-type",
      "kind": "problem-if-present",
      "equals": "invalid_signature"
    }
  ]
}
