{
  "version": 1,
  "id": "sigkey-jwks-uri",
  "title": "jwks_uri resolved through live metadata and JWKS",
  "role_under_test": "sigkey.verifier",
  "given": "agent-identity",
  "input": {
    "scheme": "jwks_uri",
    "alg": "Ed25519",
    "mutation": "none"
  },
  "assertions": [
    {
      "id": "status",
      "clause": "sigkey.v.jwks-uri",
      "kind": "status",
      "equals": 200
    },
    {
      "id": "verified-scheme",
      "clause": "sigkey.v.echo",
      "kind": "json-member",
      "member": "scheme",
      "equals": "jwks_uri"
    }
  ]
}
