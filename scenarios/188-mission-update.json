{
  "version": 1,
  "id": "mission-update",
  "title": "Missions: An accepted update leaves the mission active",
  "role_under_test": "mission.person-server",
  "given": "agent-identity",
  "input": {
    "flow": "update"
  },
  "assertions": [
    {
      "id": "action-status-class-0",
      "stage": "action",
      "kind": "status-class",
      "equals": "2xx",
      "clause": "mission.host-policy"
    },
    {
      "id": "person-mission-person-token-1",
      "stage": "person",
      "kind": "mission-person-token",
      "equals": true,
      "clause": "mission.person-token-claim"
    }
  ]
}
