{
  "version": 1,
  "id": "fixture-ps-as-resource-ps",
  "title": "Independent PS: refuse a Resource challenge naming another PS",
  "role_under_test": "authorization.federated",
  "given": "agent-identity",
  "token": {
    "iat_offset": -10,
    "exp_offset": 600
  },
  "federated": {
    "mutation": "as-resource-ps",
    "harness_ps": true
  },
  "assertions": [
    {
      "id": "initial-status-0",
      "stage": "initial",
      "kind": "status",
      "equals": 401,
      "clause": "fed.person-required"
    },
    {
      "id": "initial-sfv-token-1",
      "stage": "initial",
      "kind": "sfv-token",
      "equals": "person-token",
      "clause": "fed.person-required",
      "header": "AAuth-Requirement",
      "member": "requirement"
    },
    {
      "id": "challenge-status-4",
      "stage": "challenge",
      "kind": "status",
      "equals": 401,
      "clause": "fed.challenge"
    },
    {
      "id": "challenge-sfv-token-5",
      "stage": "challenge",
      "kind": "sfv-token",
      "equals": "auth-token",
      "clause": "fed.challenge",
      "header": "AAuth-Requirement",
      "member": "requirement"
    },
    {
      "id": "challenge-fed-challenge-6",
      "stage": "challenge",
      "kind": "fed-challenge",
      "equals": true,
      "clause": "fed.challenge"
    },
    {
      "id": "access-status-9",
      "stage": "access",
      "kind": "status",
      "equals": 400,
      "clause": "fed.as-binding"
    },
    {
      "id": "access-ps-no-token-10",
      "stage": "access",
      "kind": "ps-no-token",
      "equals": true,
      "clause": "fed.as-binding"
    },
    {
      "id": "access-json-member-11",
      "stage": "access",
      "kind": "json-member",
      "equals": "invalid_resource_token",
      "clause": "fed.as-binding",
      "member": "error"
    }
  ]
}
