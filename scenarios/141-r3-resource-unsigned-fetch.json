{
  "version": 1,
  "id": "r3-resource-unsigned-fetch",
  "title": "An unsigned request for the R3 document is refused",
  "role_under_test": "r3.resource",
  "given": "agent-identity",
  "input": {
    "topology": "four-party",
    "operations": [
      "records.read"
    ],
    "fetches": [
      "unsigned"
    ]
  },
  "assertions": [
    {
      "id": "fetch-unsigned-refused",
      "stage": "fetch-unsigned",
      "clause": "r3.resource.document-signature",
      "kind": "status-class",
      "equals": "4xx"
    },
    {
      "id": "fetch-unsigned-no-document",
      "stage": "fetch-unsigned",
      "clause": "r3.resource.document-signature",
      "kind": "r3-no-document",
      "equals": true
    }
  ]
}
