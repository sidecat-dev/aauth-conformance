{
  "version": 1,
  "id": "budget-four-party-omission",
  "title": "Omitting the PS-to-AS Budget is not a grant",
  "role_under_test": "authorization.federated",
  "given": "agent-identity",
  "token": {
    "iat_offset": -10,
    "exp_offset": 600
  },
  "federated": {
    "mutation": "none",
    "budget": "omit"
  },
  "assertions": [
    {
      "id": "challenge-status",
      "stage": "challenge",
      "kind": "status",
      "equals": 200,
      "clause": "budget.four-party-omission"
    },
    {
      "id": "challenge-budget",
      "stage": "challenge",
      "kind": "fed-budget",
      "equals": {"amount": 9000000, "unit": "credits", "decimals": 0},
      "clause": "budget.four-party-omission"
    },
    {
      "id": "access-budget",
      "stage": "access",
      "kind": "fed-budget",
      "equals": null,
      "clause": "budget.four-party-omission"
    },
    {
      "id": "token-status",
      "stage": "token",
      "kind": "status",
      "equals": 200,
      "clause": "budget.four-party-omission"
    },
    {
      "id": "token-jwt",
      "stage": "token",
      "kind": "ps-jwt",
      "equals": true,
      "clause": "fed.delivery"
    },
    {
      "id": "token-budget",
      "stage": "token",
      "kind": "fed-budget",
      "equals": null,
      "clause": "budget.four-party-omission"
    },
    {
      "id": "protected-status",
      "stage": "protected",
      "kind": "status",
      "equals": 200,
      "clause": "fed.application"
    },
    {
      "id": "protected-subject",
      "stage": "protected",
      "kind": "json-member",
      "equals": "directed-person-1",
      "clause": "fed.application",
      "member": "sub"
    }
  ]
}
