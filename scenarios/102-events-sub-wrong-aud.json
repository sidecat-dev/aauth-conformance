{
  "version": 1,
  "id": "events-sub-wrong-aud",
  "title": "Subscribe token for another Resource",
  "role_under_test": "events.subscription",
  "given": "agent-identity",
  "input": {
    "mutation": "wrong-aud"
  },
  "assertions": [
    {
      "stage": "registration",
      "id": "status",
      "clause": "events.sub.aud",
      "kind": "status",
      "equals": 401
    },
    {
      "stage": "registration",
      "id": "error",
      "clause": "events.sub.verification",
      "kind": "sfv-token-present",
      "header": "Signature-Error",
      "member": "error",
      "equals": true
    }
  ]
}
