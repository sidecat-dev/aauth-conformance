{
  "version": 1,
  "id": "r3-federated-class",
  "title": "Four-party: the AS fetches as itself and issues the R3 claims",
  "role_under_test": "r3.federated-issuer",
  "given": "agent-identity",
  "input": {
    "document": "exact",
    "operations": [
      "records.read",
      "records.export"
    ]
  },
  "assertions": [
    {
      "id": "as-fetched",
      "stage": "fetch-access",
      "clause": "r3.as.fetch",
      "kind": "r3-fetched",
      "equals": true
    },
    {
      "id": "as-fetch-proof",
      "stage": "fetch-access",
      "clause": "r3.as.fetch-signature",
      "kind": "r3-fetch-proof",
      "equals": true
    },
    {
      "id": "ps-fetch-proof",
      "stage": "fetch-person",
      "clause": "r3.as.ps-fetch-signature",
      "kind": "r3-fetch-proof",
      "equals": true
    },
    {
      "id": "auth-token",
      "stage": "token",
      "clause": "r3.as.auth-claims",
      "kind": "r3-auth-token",
      "equals": true
    }
  ]
}
