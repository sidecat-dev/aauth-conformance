{
  "version": 1,
  "id": "subagent-child-direct",
  "title": "A child signing its own Person Server request is refused",
  "role_under_test": "authorization.subagent",
  "given": "agent-identity",
  "token": {
    "iat_offset": -10,
    "exp_offset": 600
  },
  "subagent": {
    "outcome": "child-direct"
  },
  "assertions": [
    {
      "id": "person-subagent-refused-0",
      "stage": "person",
      "kind": "subagent-refused",
      "equals": true,
      "clause": "subagent.mediation"
    },
    {
      "id": "person-subagent-no-token-1",
      "stage": "person",
      "kind": "subagent-no-token",
      "equals": true,
      "clause": "subagent.identity"
    }
  ]
}
