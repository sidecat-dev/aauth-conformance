{
  "version": 1,
  "id": "events-ap-expired",
  "title": "Event token with exp in the past",
  "role_under_test": "events.agent-provider",
  "given": "agent-identity",
  "input": {
    "max_uses": 0,
    "deliveries": [
      {
        "mutation": "expired",
        "body": true
      }
    ]
  },
  "assertions": [
    {
      "stage": "delivery-1",
      "id": "status",
      "clause": "events.ap.validation",
      "kind": "status",
      "equals": 401
    },
    {
      "stage": "delivery-1",
      "id": "error",
      "clause": "events.ap.expired-code",
      "kind": "sfv-token",
      "header": "Signature-Error",
      "member": "error",
      "equals": "expired_jwt"
    },
    {
      "stage": "delivery-1",
      "id": "problem-type",
      "clause": "events.ap.problem-type",
      "kind": "problem-if-present",
      "equals": "expired_jwt"
    }
  ]
}
