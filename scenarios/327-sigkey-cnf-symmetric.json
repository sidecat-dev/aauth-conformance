{
  "version": 1,
  "id": "sigkey-cnf-symmetric",
  "title": "Agent token cnf.jwk conveying an HS256 key",
  "role_under_test": "sigkey.verifier",
  "given": "agent-identity",
  "input": {
    "scheme": "jwt",
    "alg": "Ed25519",
    "mutation": "symmetric"
  },
  "assertions": [
    {
      "id": "status",
      "clause": "sigkey.v.cnf-symmetric",
      "kind": "status",
      "equals": 401
    },
    {
      "id": "error-present",
      "clause": "sigkey.v.cnf-symmetric",
      "kind": "sfv-token-present",
      "header": "Signature-Error",
      "member": "error",
      "equals": true
    }
  ]
}
