{
  "version": 1,
  "id": "events-ap-delivery-without-body",
  "title": "Valid delivery without a body or body_s256",
  "role_under_test": "events.agent-provider",
  "given": "agent-identity",
  "input": {
    "max_uses": 0,
    "deliveries": [
      {
        "mutation": "none",
        "body": false
      }
    ]
  },
  "assertions": [
    {
      "stage": "subscribe",
      "id": "subscribe-token",
      "clause": "events.ap.subscribe-token",
      "kind": "events-subscribe-token",
      "equals": true
    },
    {
      "stage": "delivery-1",
      "id": "accepted",
      "clause": "events.ap.accepted",
      "kind": "status",
      "equals": 202
    }
  ]
}
