{
  "version": 1,
  "id": "budget-header",
  "title": "A reserved Budget header states remaining and the hold",
  "role_under_test": "authorization.federated",
  "given": "agent-identity",
  "token": {
    "iat_offset": -10,
    "exp_offset": 600
  },
  "federated": {
    "mutation": "none",
    "harness_ps": true,
    "budget": "header"
  },
  "assertions": [
    {
      "id": "access-budget",
      "stage": "access",
      "kind": "fed-budget",
      "equals": {"amount": 2000000, "unit": "credits", "decimals": 0},
      "clause": "budget.four-party-grant"
    },
    {
      "id": "reserved-status",
      "stage": "reserved",
      "kind": "status",
      "equals": 200,
      "clause": "budget.header"
    },
    {
      "id": "reserved-remaining",
      "stage": "reserved",
      "kind": "sfv-integer",
      "equals": 1200000,
      "clause": "budget.header",
      "header": "AAuth-Budget",
      "member": "remaining"
    },
    {
      "id": "reserved-hold",
      "stage": "reserved",
      "kind": "sfv-integer",
      "equals": 800000,
      "clause": "budget.header",
      "header": "AAuth-Budget",
      "member": "reserved"
    },
    {
      "id": "reserved-no-cost",
      "stage": "reserved",
      "kind": "sfv-absent",
      "equals": true,
      "clause": "budget.header",
      "header": "AAuth-Budget",
      "member": "cost"
    },
    {
      "id": "reserved-trailer-cost",
      "stage": "reserved",
      "kind": "sfv-trailer-if-present",
      "equals": 400000,
      "clause": "budget.trailer",
      "header": "AAuth-Budget",
      "member": "cost"
    },
    {
      "id": "reserved-trailer-no-remaining",
      "stage": "reserved",
      "kind": "sfv-trailer-absent",
      "equals": true,
      "clause": "budget.trailer",
      "header": "AAuth-Budget",
      "member": "remaining"
    },
    {
      "id": "reserved-trailer-no-hold",
      "stage": "reserved",
      "kind": "sfv-trailer-absent",
      "equals": true,
      "clause": "budget.trailer",
      "header": "AAuth-Budget",
      "member": "reserved"
    },
    {
      "id": "reserved-trailer-declared",
      "stage": "reserved",
      "kind": "trailer-declared-if-present",
      "equals": true,
      "clause": "budget.trailer",
      "header": "AAuth-Budget"
    },
    {
      "id": "following-remaining",
      "stage": "following",
      "kind": "sfv-integer",
      "equals": 1500000,
      "clause": "budget.header",
      "header": "AAuth-Budget",
      "member": "remaining"
    },
    {
      "id": "following-hold",
      "stage": "following",
      "kind": "sfv-integer",
      "equals": 100000,
      "clause": "budget.header",
      "header": "AAuth-Budget",
      "member": "reserved"
    }
  ]
}
