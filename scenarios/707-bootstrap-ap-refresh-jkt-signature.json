{
  "version": 1,
  "id": "bootstrap-ap-refresh-jkt-signature",
  "title": "A naming JWT whose signature does not verify with its header key gets no agent token",
  "role_under_test": "bootstrap.agent-provider",
  "given": "agent-identity",
  "input": {
    "flow": "refresh",
    "mutation": "jkt-signature"
  },
  "assertions": [
    {
      "stage": "enroll",
      "id": "enroll-accepted",
      "clause": "bootstrap.ap.enrollment",
      "kind": "status-class",
      "equals": "2xx"
    },
    {
      "stage": "refresh",
      "id": "refused",
      "clause": "bootstrap.ap.naming-jwt",
      "kind": "bootstrap-no-token",
      "equals": true
    }
  ]
}
