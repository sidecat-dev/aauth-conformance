{
  "version": 1,
  "id": "bootstrap-ap-single-key",
  "title": "A single-key refresh signed under hwk by the durable key returns a token bound to that key",
  "role_under_test": "bootstrap.agent-provider",
  "given": "agent-identity",
  "input": {
    "flow": "single-key",
    "mutation": "none"
  },
  "assertions": [
    {
      "stage": "enroll",
      "id": "enroll-accepted",
      "clause": "bootstrap.ap.enrollment",
      "kind": "status-class",
      "equals": "2xx"
    },
    {
      "stage": "refresh",
      "id": "single-key-status",
      "clause": "bootstrap.ap.single-key",
      "kind": "status",
      "equals": 200
    },
    {
      "stage": "refresh",
      "id": "single-key-signature",
      "clause": "bootstrap.ap.single-key",
      "kind": "bootstrap-token",
      "member": "signature",
      "equals": true
    },
    {
      "stage": "refresh",
      "id": "single-key-claims",
      "clause": "bootstrap.ap.single-key",
      "kind": "bootstrap-token",
      "member": "claims",
      "equals": true
    },
    {
      "stage": "refresh",
      "id": "single-key-identifier",
      "clause": "bootstrap.ap.single-key",
      "kind": "bootstrap-token",
      "member": "identifier",
      "equals": true
    },
    {
      "stage": "refresh",
      "id": "single-key-key",
      "clause": "bootstrap.ap.single-key",
      "kind": "bootstrap-token",
      "member": "key",
      "equals": true
    }
  ]
}
