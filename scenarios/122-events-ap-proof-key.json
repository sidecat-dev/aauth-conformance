{
  "version": 1,
  "id": "events-ap-proof-key",
  "title": "HTTP signature by a key other than the event token's",
  "role_under_test": "events.agent-provider",
  "given": "agent-identity",
  "input": {
    "max_uses": 0,
    "deliveries": [
      {
        "mutation": "proof-key",
        "body": true
      }
    ]
  },
  "assertions": [
    {
      "stage": "delivery-1",
      "id": "status",
      "clause": "events.ap.same-key",
      "kind": "status",
      "equals": 401
    },
    {
      "stage": "delivery-1",
      "id": "error",
      "clause": "events.ap.signature-code",
      "kind": "sfv-token",
      "header": "Signature-Error",
      "member": "error",
      "equals": "invalid_signature"
    },
    {
      "stage": "delivery-1",
      "id": "problem-type",
      "clause": "events.ap.problem-type",
      "kind": "problem-if-present",
      "equals": "invalid_signature"
    }
  ]
}
