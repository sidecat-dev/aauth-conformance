{
  "version": 1,
  "id": "ps-short-parent",
  "title": "Issued credentials respect short Agent parent lifetime",
  "role_under_test": "person-server.direct",
  "given": "agent-identity",
  "person": {
    "mutation": "short-parent"
  },
  "token": {
    "iat_offset": -10,
    "exp_offset": 600
  },
  "assertions": [
    {
      "id": "person-status",
      "clause": "ps.person-endpoint",
      "kind": "status",
      "stage": "person",
      "equals": 200
    },
    {
      "id": "person-signature",
      "clause": "ps.common-verification",
      "kind": "ps-jwt-signature",
      "stage": "person",
      "equals": true
    },
    {
      "id": "person-identity",
      "clause": "ps.person-structure",
      "kind": "ps-jwt-identity",
      "stage": "person",
      "equals": true
    },
    {
      "id": "person-key",
      "clause": "ps.person-structure",
      "kind": "ps-jwt-key",
      "stage": "person",
      "equals": true
    },
    {
      "id": "person-lifetime",
      "clause": "ps.person-lifetime",
      "kind": "ps-jwt-lifetime",
      "stage": "person",
      "equals": true
    },
    {
      "id": "person-authorization",
      "clause": "ps.person-no-authorization",
      "kind": "ps-jwt-no-authorization",
      "stage": "person",
      "equals": true
    },
    {
      "id": "auth-status",
      "clause": "ps.auth-endpoint",
      "kind": "status",
      "stage": "token",
      "equals": 200
    },
    {
      "id": "auth-signature",
      "clause": "ps.common-verification",
      "kind": "ps-jwt-signature",
      "stage": "token",
      "equals": true
    },
    {
      "id": "auth-identity",
      "clause": "ps.auth-structure",
      "kind": "ps-jwt-identity",
      "stage": "token",
      "equals": true
    },
    {
      "id": "auth-key",
      "clause": "ps.auth-structure",
      "kind": "ps-jwt-key",
      "stage": "token",
      "equals": true
    },
    {
      "id": "auth-lifetime",
      "clause": "ps.auth-lifetime",
      "kind": "ps-jwt-lifetime",
      "stage": "token",
      "equals": true
    },
    {
      "id": "auth-authorization",
      "clause": "ps.host-scope-policy",
      "kind": "ps-jwt-scope",
      "stage": "token",
      "equals": true
    },
    {
      "id": "configured-person",
      "clause": "ps.host-person-profile",
      "kind": "ps-jwt-subject",
      "stage": "person",
      "equals": true
    }
  ]
}
