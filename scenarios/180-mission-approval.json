      "clause": "mission.approval-s256"
    },
    {
      "id": "approval-mission-encoded-2",
      "stage": "approval",
      "kind": "mission-encoded",
      "equals": true,
      "clause": "mission.approval-encoding"
    },
    {
      "id": "approval-mission-blob-3",
      "stage": "approval",
      "kind": "mission-blob",
      "equals": true,
      "clause": "mission.blob-members"
