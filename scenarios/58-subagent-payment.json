{
  "version": 1,
  "id": "subagent-payment",
  "title": "Parent-mediated sub-agent: payment",
  "role_under_test": "authorization.subagent",
  "given": "agent-identity",
  "token": {
    "iat_offset": -10,
    "exp_offset": 600
  },
  "subagent": {
    "outcome": "payment"
  },
  "assertions": [
    {
      "id": "person-status-0",
      "stage": "person",
      "kind": "status",
      "equals": 200,
      "clause": "subagent.identity"
    },
    {
      "id": "person-subagent-jwt-1",
      "stage": "person",
      "kind": "subagent-jwt",
      "equals": true,
      "clause": "subagent.identity"
    },
    {
      "id": "access-subagent-proof-2",
      "stage": "access",
      "kind": "subagent-proof",
      "equals": true,
      "clause": "subagent.proof"
    },
    {
      "id": "access-subagent-forwarded-3",
      "stage": "access",
      "kind": "subagent-forwarded",
      "equals": true,
      "clause": "subagent.forwarding"
    },
    {
      "id": "access-status-4",
      "stage": "access",
      "kind": "status",
      "equals": 402,
      "clause": "subagent.pending"
    },
    {
      "id": "access-subagent-pending-5",
      "stage": "access",
      "kind": "subagent-pending",
      "equals": true,
      "clause": "subagent.pending"
    },
    {
      "id": "pending-status-6",
      "stage": "pending",
      "kind": "status",
      "equals": 202,
      "clause": "subagent.pending"
    },
    {
      "id": "pending-subagent-pending-7",
      "stage": "pending",
      "kind": "subagent-pending",
      "equals": true,
      "clause": "subagent.pending"
    },
    {
      "id": "pending-subagent-no-token-8",
      "stage": "pending",
      "kind": "subagent-no-token",
      "equals": true,
      "clause": "subagent.delivery"
    },
    {
      "id": "child-poll-status-9",
      "stage": "child-poll",
      "kind": "status",
      "equals": 403,
      "clause": "subagent.mediation"
    },
    {
      "id": "child-poll-subagent-no-token-10",
      "stage": "child-poll",
      "kind": "subagent-no-token",
      "equals": true,
      "clause": "subagent.mediation"
    },
    {
      "id": "waiting-status-11",
      "stage": "waiting",
      "kind": "status",
      "equals": 202,
      "clause": "subagent.pending"
    },
    {
      "id": "waiting-subagent-pending-12",
      "stage": "waiting",
      "kind": "subagent-pending",
      "equals": true,
      "clause": "subagent.pending"
    },
    {
      "id": "approval-status-13",
      "stage": "approval",
      "kind": "status",
      "equals": 202,
      "clause": "subagent.pending"
    },
    {
      "id": "approval-subagent-proof-14",
      "stage": "approval",
      "kind": "subagent-proof",
      "equals": true,
      "clause": "subagent.proof"
    },
    {
      "id": "approval-subagent-pending-15",
      "stage": "approval",
      "kind": "subagent-pending",
      "equals": true,
      "clause": "subagent.pending"
    },
    {
      "id": "result-subagent-proof-16",
      "stage": "result",
      "kind": "subagent-proof",
      "equals": true,
      "clause": "subagent.proof"
    },
    {
      "id": "gone-status-17",
      "stage": "gone",
      "kind": "status",
      "equals": 410,
      "clause": "subagent.finite"
    },
    {
      "id": "token-status-18",
      "stage": "token",
      "kind": "status",
      "equals": 200,
      "clause": "subagent.delivery"
    },
    {
      "id": "token-subagent-jwt-19",
      "stage": "token",
      "kind": "subagent-jwt",
      "equals": true,
      "clause": "subagent.delivery"
    },
    {
      "id": "protected-status-20",
      "stage": "protected",
      "kind": "status",
      "equals": 200,
      "clause": "subagent.host"
    },
    {
      "id": "protected-json-member-21",
      "stage": "protected",
      "kind": "json-member",
      "equals": "directed-person-1",
      "clause": "subagent.host",
      "member": "sub"
    },
    {
      "id": "parent-use-subagent-refused-22",
      "stage": "parent-use",
      "kind": "subagent-refused",
      "equals": true,
      "clause": "subagent.mediation"
    }
  ]
}
