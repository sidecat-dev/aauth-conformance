  {:id "budgets:419" :draft "budgets" :line 419 :level :must :section "authorization-endpoint" :text "The resource MUST NOT reject the request because `budget.amount` exceeds what it will grant; it narrows instead (#narrowing-chain)." :suite-clauses [] :scenarios []}
