  {:id "budgets:1107" :draft "budgets" :line 1107 :level :may :section "errors" :text "A PS or AS that has no cached `budget_units` for the resource and cannot fetch the metadata MAY proceed on the resource token's `decimals`, which is signed by the resource." :suite-clauses [] :scenarios []}
