  {:id "key:199" :draft "key" :line 199 :level :must :section "multiple-signatures" :text "When multiple signatures are required, the complete Signature-Key header (containing all keys) MUST be populated before any signature is created, and each signature MUST cover `signature-key`." :suite-clauses ["sigkey.v.unknown-scheme" "sigkey.v.missing-member-jwt" "sigkey.v.missing-member-hwk" "sigvec.reject.unknown-scheme"] :scenarios ["sigkey-unknown-scheme" "sigkey-missing-member-jwt" "sigkey-missing-member-hwk" "sigvec.reject-unknown-scheme"] :status {:aauth-go :pass :aauth-rust :pass}}
