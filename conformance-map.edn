  {:id "budgets:625" :draft "budgets" :line 625 :level :may :section "aauth-budget-header" :text "- **`unit`** (OPTIONAL): A String naming the unit." :suite-clauses ["budget.header"] :scenarios ["budget-header"] :status {:aauth-go :pass :aauth-rust :pass}}
  {:id "budgets:625.2" :draft "budgets" :line 625 :level :may :section "aauth-budget-header" :text "**`decimals`** (OPTIONAL): an Integer giving its scale." :suite-clauses ["budget.header"] :scenarios ["budget-header"] :status {:aauth-go :pass :aauth-rust :pass}}
  {:id "budgets:625.3" :draft "budgets" :line 625 :level :must :section "aauth-budget-header" :text "Both are informational, and they are a pair: a sender MUST include both or neither." :suite-clauses ["budget.header"] :scenarios ["budget-header"] :status {:aauth-go :pass :aauth-rust :pass}}
  {:id "budgets:627" :draft "budgets" :line 627 :level :must :section "aauth-budget-header" :text "Recipients MUST ignore members they do not recognize." :suite-clauses ["budget.header"] :scenarios ["budget-header"] :status {:aauth-go :pass :aauth-rust :pass}}
  {:id "budgets:635" :draft "budgets" :line 635 :level :should :section "header-rules" :text "A resource that granted a budget SHOULD include `AAuth-Budget` on every response to a request bearing that auth token — success, error, and the challenge, `401` or `202` (#exhaustion-deferred), where it reads `remaining=0` beside the `AAuth-Requirement` header (#exhaustion)." :suite-clauses ["budget.header"] :scenarios ["budget-header"] :status {:aauth-go :pass :aauth-rust :pass}}
  {:id "budgets:637" :draft "budgets" :line 637 :level :must :section "header-rules" :text "This is SHOULD rather than MUST because the failing layer may sit below the metering layer: a gateway timeout, a crashed worker, or a fault in metering itself produces a response no budget figure can ride on." :suite-clauses ["budget.header"] :scenarios ["budget-header"] :status {:aauth-go :pass :aauth-rust :pass}}
  {:id "budgets:637.2" :draft "budgets" :line 637 :level :must :section "header-rules" :text "A resource MUST NOT omit the field for any other reason." :suite-clauses ["budget.header"] :scenarios ["budget-header"] :status {:aauth-go :pass :aauth-rust :pass}}
  {:id "budgets:648" :draft "budgets" :line 648 :level :must :section "header-rules" :text "Intermediaries MUST NOT add, alter, or remove `AAuth-Budget`." :suite-clauses ["budget.header"] :scenarios ["budget-header"] :status {:aauth-go :pass :aauth-rust :pass}}
  {:id "budgets:650" :draft "budgets" :line 650 :level :must :section "header-rules" :text "Recipients MUST ignore `AAuth-Budget` on a response served from cache with a positive `current_age` ([@!RFC9111], Section 4.2.3)." :suite-clauses ["budget.header"] :scenarios ["budget-header"] :status {:aauth-go :pass :aauth-rust :pass}}
  {:id "budgets:654" :draft "budgets" :line 654 :level :must :section "unit-conflict" :text "A recipient MUST NOT act on a header `unit` or `decimals` that disagrees with the `budget` claim in the auth token it presented, and SHOULD treat the whole field as unreliable for that response." :suite-clauses ["budget.header"] :scenarios ["budget-header"] :status {:aauth-go :pass :aauth-rust :pass}}
  {:id "budgets:662" :draft "budgets" :line 662 :level :should :section "streaming" :text "A resource serving a streamed response SHOULD send `reserved` in the header and `cost` in a trailer." :suite-clauses [] :scenarios []}
