  {:id "budgets:1304" :draft "budgets" :line 1304 :level :may :section "why-not-ratelimit" :text "Intermediaries MAY tighten `RateLimit` values." :suite-clauses [] :scenarios []}
  {:id "budgets:1306" :draft "budgets" :line 1306 :level :may :section "why-not-ratelimit" :text "The two fields are complementary and MAY appear on the same response." :suite-clauses [] :scenarios []}
